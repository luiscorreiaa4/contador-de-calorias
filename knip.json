{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "backend": {
      "entry": [
        "scripts/*.{ts,js,mjs}",
        "tests/**/*.test.ts",
        "migrations/*.js",
        "tests/load/autocannon.js"
      ],
      "project": ["src/**/*.ts", "scripts/**", "tests/**"]
    },
    "frontend": {
      "entry": [
        "src/entry-prerender.tsx",
        "src/**/*.test.{ts,tsx}",
        "scripts/*.mjs",
        "e2e/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "shared": {
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off",
    "enumMembers": "off"
  },
  "ignoreDependencies": [
    "@caloriesync/shared",
    "@fontsource/inter",
    "@fontsource/montserrat",
    "@eslint/js",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "globals",
    "typescript-eslint"
  ]
}
