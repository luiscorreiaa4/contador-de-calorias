{
  "name": "contador-de-calorias-backend",
  "version": "1.0.0",
  "description": "Backend API Node.js + TypeScript + PostgreSQL para o Contador de Calorias",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cross-env TZ=America/Sao_Paulo tsx watch src/server.ts",
    "test": "node ../scripts/run-tests.mjs backend",
    "test:file": "node ../scripts/run-tests.mjs file",
    "migrate": "node-pg-migrate",
    "migrate:create": "node-pg-migrate create",
    "db:reset": "tsx scripts/reset-db.js && npm run migrate up",
    "db:reset:test": "cross-env NODE_ENV=test DB_NAME=contador_calorias_test tsx scripts/reset-db.js && cross-env NODE_ENV=test node-pg-migrate --database-url-var DATABASE_URL_TEST up",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "cross-env TZ=America/Sao_Paulo tsx src/server.ts",
    "test:strict": "node ../scripts/run-tests.mjs strict",
    "admin:promote": "cross-env TZ=America/Sao_Paulo tsx scripts/admin-cli.ts promote",
    "admin:demote": "cross-env TZ=America/Sao_Paulo tsx scripts/admin-cli.ts demote",
    "admin:list": "cross-env TZ=America/Sao_Paulo tsx scripts/admin-cli.ts list",
    "catalog:export": "cross-env TZ=America/Sao_Paulo tsx scripts/catalog-export.ts",
    "catalog:apply": "cross-env TZ=America/Sao_Paulo tsx scripts/catalog-apply.ts",
    "catalog:import-curated": "cross-env TZ=America/Sao_Paulo tsx scripts/catalog-import-curated.ts"
  },
  "dependencies": {
    "@sentry/node": "10.78.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "10.3.1",
    "pg": "^8.13.1",
    "tsx": "^4.23.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "archunit": "^2.5.4",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "tar": "^7.5.22",
    "braces": "^3.0.3",
    "node-pg-migrate": {
      "glob": "^14.0.3"
    },
    "hyperid": {
      "uuid": "^11.1.1"
    }
  }
}
