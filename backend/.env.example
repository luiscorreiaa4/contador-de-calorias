PORT=3001
NODE_ENV=development

# Configurações do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui
DB_NAME=contador_calorias

DATABASE_URL=postgresql://postgres:sua_senha_segura_aqui@localhost:5432/contador_calorias
DATABASE_URL_TEST=postgresql://postgres:sua_senha_segura_aqui@localhost:5432/contador_calorias_test
JWT_SECRET=preencha_com_32_caracteres_no_minimo_para_seguranca
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# BL-01 / D-19 — Número de saltos de proxy reverso confiáveis (ex: 1).
# Deixe vazio/false quando o app não estiver atrás de proxy. NUNCA use "true".
# TRUST_PROXY=1

# BL-27 / A-030 — Chaves VAPID para Web Push Notifications
# Em produção, gere via 'npx web-push generate-vapid-keys' e defina ambas.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# CA customizado para conexão SSL estrita com o banco em produção (opcional)
# DB_SSL_CA=/caminho/para/ca-certificate.crt

# Dimensionamento do pool de threads libuv para hashing bcrypt e I/O assíncrono (opcional; padrão automático: Math.max(4, os.cpus().length))
# UV_THREADPOOL_SIZE=8

# Testes: runner fixa NODE_ENV=test e DB_NAME=contador_calorias_test.
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD acima devem apontar ao Postgres de testes.
# Teto global opcional (ms); padrão 300000, intervalo permitido 1..3600000.
# TEST_PROCESS_TIMEOUT_MS=300000
