{
  "name": "contador-de-calorias-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node backend/init-db.js",
    "server": "npm --prefix backend run dev",
    "dev": "npm --prefix frontend run dev",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "build": "npm --prefix frontend run build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
