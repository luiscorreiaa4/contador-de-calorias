{
  "name": "contador-de-calorias-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix backend run migrate up",
    "server": "npm --prefix backend run dev",
    "dev": "npm --prefix frontend run dev",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "build": "npm --prefix frontend run build",
    "lint": "node scripts/check-test-hygiene.mjs && npm --prefix frontend run check:colors && eslint .",
    "test": "node scripts/run-tests.mjs backend",
    "test:backend:file": "node scripts/run-tests.mjs file",
    "test:frontend:file": "node scripts/run-tests.mjs frontend:file",
    "docker:up": "docker compose --env-file backend/.env up -d",
    "docker:down": "docker compose --env-file backend/.env down",
    "test:strict": "node scripts/run-tests.mjs strict",
    "test:file": "node scripts/run-tests.mjs file",
    "test:frontend": "node scripts/run-tests.mjs frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "brace-expansion": "^5.0.12",
    "zod": "^3.25.76"
  }
}
